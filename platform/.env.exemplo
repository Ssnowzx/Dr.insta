# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#
# Credentials are separate variables instead of a single DATABASE_URL on
# purpose: a password containing `@`, `#` or `/` breaks the URL silently, and
# the error you get is "access denied", which sends you looking in the wrong
# place.

# ---- Database -------------------------------------------------------------
# `db` is the service name in docker-compose. Running outside Docker, use
# 127.0.0.1 and publish the port via compose.dev.yml (development only).
DB_HOST=db
DB_PORT=3306
DB_NAME=myfavorite
DB_USER=myfavorite
DB_PASSWORD=change-this-password
# Used only by the MySQL container on first boot.
DB_ROOT_PASSWORD=change-this-root-password

# ---- Application ----------------------------------------------------------
# The one client this instance serves, by `client.slug`.
#
# This deployment is dedicated: one client, one instance, one database. A second
# client means a second instance with a different slug here — there is no client
# picker in the interface. The application refuses to start a request without
# this set, rather than defaulting to some client and serving the wrong data.
TENANT_SLUG=bianca-olivo

# Public address. It goes into invite and password-reset links — if it is wrong,
# the client receives a link that does not open.
APP_URL=https://plataforma.seudominio.com.br

# Port the container publishes on 127.0.0.1 for the host Nginx.
APP_PORT=3080

# Storage root for uploaded files. MUST be absolute: a relative path resolves
# against the process working directory, and the standalone server runs from
# `.next/standalone` — uploads would land inside the build output and vanish on
# the next build. Inside the container it is always this path; on the host, the
# bind mount points wherever you want.
FILES_ROOT=/var/lib/myfavorite/files

# Host path behind the container's FILES_ROOT bind mount. It has to be visible
# from the host so the rsync backup can read it without entering the container.
FILES_HOST=/var/lib/myfavorite/files

# ---- Instagram --------------------------------------------------------------
# The app you created at developers.facebook.com, product "Instagram" with
# Instagram login. Leave blank and the connect button simply is not offered —
# every other screen works without it.
#
# IG_APP_ID is the *Instagram* App ID, not the Facebook App ID. The dashboard
# shows both, under similar names, on different screens, and the wrong one fails
# with a generic error that does not say which.
IG_APP_ID=
IG_APP_SECRET=

# Encrypts the access token before it reaches the database, so a dump of
# `instagram_connection` is not enough to act on the client's account.
#
# 32 bytes, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# LOSING THIS KEY LOSES THE CONNECTION. There is no recovery, deliberately: the
# alternative is storing the token in a form the database alone can undo. The
# cost is two clicks — she reconnects. Do not rotate it without reconnecting.
ENCRYPTION_KEY=

# ---- Email ----------------------------------------------------------------
# There is none, and that is the decision, not a gap waiting to be filled.
#
# A mail server nobody maintains is a dependency that fails quietly at the worst
# moment, and a message landing in a mailbox nobody opens is the same as no
# message. Everything happens inside the platform instead: activity shows up on
# `/novidades`, and access links are minted in Conta > Acesso das clientes or
# with `npm run link -- --email <address>`, then relayed by hand.
#
# What it costs, stated plainly: password recovery is not self-service. The
# sign-in screen records the attempt so the consultant finds out without her
# having to remember to ask.
