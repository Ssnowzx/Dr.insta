# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#
# Credentials are separate variables instead of a single DATABASE_URL on
# purpose: a password containing `@`, `#` or `/` breaks the URL silently, and
# the error you get is "access denied", which sends you looking in the wrong
# place.

# ---- Database -------------------------------------------------------------
# `db` is the service name in docker-compose. Running outside Docker, use
# 127.0.0.1 and publish the port via compose.dev.yml (development only).
DB_HOST=db
DB_PORT=3306
DB_NAME=myfavorite
DB_USER=myfavorite
DB_PASSWORD=change-this-password
# Used only by the MySQL container on first boot.
DB_ROOT_PASSWORD=change-this-root-password

# ---- Application ----------------------------------------------------------
# Public address. It goes into invite and password-reset links — if it is wrong,
# the client receives a link that does not open.
APP_URL=https://plataforma.seudominio.com.br

# Port the container publishes on 127.0.0.1 for the host Nginx.
APP_PORT=3080

# Storage root for uploaded files. Inside the container it is always this path;
# on the host, the bind mount points wherever you want.
FILES_ROOT=/var/lib/myfavorite/files

# ---- Email (phase 2) ------------------------------------------------------
# Without this, invites and password resets only come out of the
# `scripts/invite.ts` CLI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
