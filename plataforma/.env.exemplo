# Copie para `.env` e preencha. O `.env` está no .gitignore — nunca commite.
#
# As credenciais são variáveis separadas em vez de uma DATABASE_URL única de
# propósito: senha com `@`, `#` ou `/` quebra a URL sem avisar, e o erro que
# aparece é "acesso negado", que manda você procurar no lugar errado.

# ---- Banco ----------------------------------------------------------------
# `db` é o nome do serviço no docker-compose. Rodando fora do Docker, use
# 127.0.0.1 e publique a porta no compose (só em desenvolvimento).
BANCO_HOST=db
BANCO_PORTA=3306
BANCO_NOME=myfavorite
BANCO_USUARIO=myfavorite
BANCO_SENHA=troque-esta-senha
# Usada só pelo contêiner do MySQL na primeira subida.
BANCO_SENHA_ROOT=troque-esta-senha-root

# ---- Aplicação ------------------------------------------------------------
# Endereço público. Entra nos links de convite e de recuperação de senha —
# se estiver errado, a cliente recebe um link que não abre.
APP_URL=https://plataforma.seudominio.com.br

# Porta que o contêiner expõe em 127.0.0.1 para o Nginx do host.
APP_PORTA=3080

# Raiz de armazenamento dos arquivos enviados. Dentro do contêiner é sempre
# este caminho; no host, o volume aponta para onde você quiser.
ARQUIVOS_RAIZ=/var/lib/myfavorite/arquivos

# ---- E-mail (Fase 2) ------------------------------------------------------
# Sem isto, convite e recuperação de senha só saem pelo CLI `scripts/convidar.ts`.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
