{
  "name": "myfavorite-plataforma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de consultoria de Instagram: entregas, demandas, etapas e serie historica de metricas.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "banco:migrar": "tsx --env-file-if-exists=.env banco/migrar.ts",
    "banco:semear": "tsx --env-file-if-exists=.env banco/semear.ts",
    "banco:estado": "tsx --env-file-if-exists=.env banco/migrar.ts --estado"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.23.2",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
